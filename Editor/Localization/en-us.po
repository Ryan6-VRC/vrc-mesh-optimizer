msgid ""
msgstr ""
"Language: en-us\n"

msgid "MeshOptimizer"
msgstr "Mesh Optimizer"

msgid "MeshOptimizer:decimate"
msgstr "Decimate"

msgid "MeshOptimizer:decimate:tooltip"
msgstr "Collapse edges to lower the triangle count, keeping the shape wherever the avatar deforms or animates it."

msgid "MeshOptimizer:removeHiddenTriangles"
msgstr "Remove hidden triangles"

msgid "MeshOptimizer:removeHiddenTriangles:tooltip"
msgstr "Delete triangles that an always-on renderer riding the same bones covers from every direction."

msgid "MeshOptimizer:target"
msgstr "Target"

msgid "MeshOptimizer:target:tooltip"
msgstr "Reduce to a triangle count for the whole avatar, or as far as a tolerance allows."

msgid "TargetKind:TriangleBudget"
msgstr "Triangle count"

msgid "TargetKind:Tolerance"
msgstr "Tolerance"

msgid "MeshOptimizer:triangleBudget"
msgstr "Triangle count"

msgid "MeshOptimizer:triangleBudget:tooltip"
msgstr "Triangles for the whole avatar after optimization."

msgid "MeshOptimizer:maxError"
msgstr "Max error (mm)"

msgid "MeshOptimizer:maxError:tooltip"
msgstr "With a triangle count as the target, the farthest, in millimetres, the optimized surface may stray from the original to reach it. A count reachable only past this is left unmet. 0 turns the limit off."

msgid "MeshOptimizer:tolerance"
msgstr "Tolerance (mm)"

msgid "MeshOptimizer:tolerance:tooltip"
msgstr "The farthest, in millimetres, the optimized surface may stray from the original."

msgid "MeshOptimizer:alwaysOn"
msgstr "Always-on renderers"

msgid "MeshOptimizer:alwaysOn:tooltip"
msgstr "Renderers that are never hidden. Only these can hide another renderer's triangles, so leave out anything that can be toggled off."

msgid "MeshOptimizer:outlinesShowInside"
msgstr "Outlines show the inside"

msgid "MeshOptimizer:outlinesShowInside:tooltip"
msgstr "Keep a covered triangle whose material's outline draws its back side, for a garment whose inside is seen through its outline. Off removes more, mostly skin under clothing."

msgid "MeshOptimizer:materials"
msgstr "Material occlusion"

msgid "MeshOptimizer:materials:tooltip"
msgstr "Per material, whether its surface hides what is behind it."

msgid "MaterialOcclusion:material"
msgstr "Material"

msgid "MaterialOcclusion:mode"
msgstr "Occlusion"

msgid "OcclusionMode:Automatic"
msgstr "Automatic"

msgid "OcclusionMode:Automatic:tooltip"
msgstr "Opaque when its render queue and render type say so; otherwise its texture's alpha decides."

msgid "OcclusionMode:ForceOpaque"
msgstr "Always opaque"

msgid "OcclusionMode:ForceOpaque:tooltip"
msgstr "Treat the whole surface as solid, whatever its alpha."

msgid "OcclusionMode:NeverOccludes"
msgstr "Never occludes"

msgid "OcclusionMode:NeverOccludes:tooltip"
msgstr "Never let this material hide anything behind it."

msgid "MeshOptimizer:renderers"
msgstr "Renderer settings"

msgid "RendererSettings:renderer"
msgstr "Renderer"

msgid "RendererSettings:excludeFromDecimation"
msgstr "Exclude from decimation"

msgid "RendererSettings:excludeFromDecimation:tooltip"
msgstr "Never decimate this renderer. Its hidden triangles are still removed."

msgid "RendererSettings:protection"
msgstr "Protection"

msgid "RendererSettings:protection:tooltip"
msgstr "How much detail this renderer keeps: its error counts this many times over against the target. 1 is neutral; higher keeps more."

msgid "MeshOptimizer:faceFloor"
msgstr "Face keeps at least"

msgid "MeshOptimizer:faceFloor:tooltip"
msgstr "The share of its triangles the lip-sync face renderer keeps, whatever the target. Its expressions deform it most and other players watch it, so the reduction is spent elsewhere first."

msgid "MeshOptimizer:lockFingers"
msgstr "Lock fingers"

msgid "MeshOptimizer:lockFingers:tooltip"
msgstr "Keep every vertex that rides a finger, found through the humanoid rig. Fingers bend at every joint and thin out quickly when decimated."

msgid "MeshOptimizer:fingerWeight"
msgstr "Finger weight"

msgid "MeshOptimizer:fingerWeight:tooltip"
msgstr "A vertex with at least this much skin weight on a finger bone counts as a finger vertex. Lower locks more of the hand."

msgid "MeshOptimizer:advanced"
msgstr "Advanced"

msgid "MeshOptimizer:preset"
msgstr "Preset"

msgid "MeshOptimizer:preset:tooltip"
msgstr "A tolerance to start from. Fine keeps the most detail and Coarse removes the most; editing the tolerance by hand makes it Custom."

msgid "TolerancePreset:Fine"
msgstr "Fine (0.5 mm)"

msgid "TolerancePreset:Standard"
msgstr "Standard (1 mm)"

msgid "TolerancePreset:Medium"
msgstr "Medium (2 mm)"

msgid "TolerancePreset:Coarse"
msgstr "Coarse (3 mm)"

msgid "TolerancePreset:Custom"
msgstr "Custom"

msgid "MeshOptimizer:preview"
msgstr "Preview decimation"

msgid "MeshOptimizer:preview:tooltip"
msgstr "Show the decimated meshes in the Scene view. The first preview records every mesh and can take a while; changing the target afterwards only re-cuts."

msgid "MeshOptimizer:preview:off"
msgstr "The preview is off."

msgid "MeshOptimizer:preview:pending"
msgstr "The preview is being computed."

msgid "MeshOptimizer:preview:result"
msgstr "Triangles {0} before, {1} after; error level {2} mm"

msgid "MeshOptimizer:preview:failed"
msgstr "The preview failed: {0}"

msgid "MeshOptimizer:preview:note:controllers"
msgstr "The preview shows decimation only; hidden triangles are removed at build. Shape keys are judged from the avatar's own animators, before other tools add theirs, so the build's count can differ."

msgid "MeshOptimizer:preview:note:every-key-live"
msgstr "The preview shows decimation only; hidden triangles are removed at build. No animator was found, so every shape key is judged as animated and the build can cut deeper."

msgid "MeshOptimizer:preview:progress"
msgstr "Mesh Optimizer preview"

msgid "MeshOptimizer:preview:progress:info"
msgstr "Recording the decimation of {0}"

msgid "MeshOptimizer:diag:not-readable"
msgstr "Mesh Optimizer cannot read {1}"

msgid "MeshOptimizer:diag:not-readable:description"
msgstr "{0} was left as it was: its mesh {1} does not allow reading in play mode."

msgid "MeshOptimizer:diag:not-readable:hint"
msgstr "Turn on Read/Write in the model's import settings, or build for upload, where the mesh can be read."

msgid "MeshOptimizer:diag:cloth"
msgstr "Mesh Optimizer skipped a renderer with Cloth"

msgid "MeshOptimizer:diag:cloth:description"
msgstr "{0} was left as it was: its Cloth component addresses the mesh's vertices by index, so they cannot be removed."

msgid "MeshOptimizer:diag:cloth:hint"
msgstr "Nothing to do unless this renderer's triangle count matters; then reduce its mesh before it gets Cloth."

msgid "MeshOptimizer:diag:renderer-failed"
msgstr "Mesh Optimizer failed on a renderer"

msgid "MeshOptimizer:diag:renderer-failed:description"
msgstr "{0} failed during {1}: {2}. Every other renderer was still optimized."

msgid "MeshOptimizer:diag:renderer-failed:hint"
msgstr "The console holds the full error. A renderer that failed during Extraction or Writing was left as it was; one that failed during Decimation kept only its hidden-triangle removal."

msgid "MeshOptimizer:diag:occlusion-failed"
msgstr "Mesh Optimizer could not find hidden triangles"

msgid "MeshOptimizer:diag:occlusion-failed:description"
msgstr "Removing hidden triangles failed, so no triangle was removed for being hidden: {0}"

msgid "MeshOptimizer:diag:occlusion-failed:hint"
msgstr "The console holds the full error. Decimation still ran."

msgid "MeshOptimizer:diag:rejudge-failed"
msgstr "Mesh Optimizer could not check hidden triangles against the decimated meshes"

msgid "MeshOptimizer:diag:rejudge-failed:description"
msgstr "Checking whether decimation uncovered any removed hidden triangle failed, so they stay removed as first found: {0}"

msgid "MeshOptimizer:diag:rejudge-failed:hint"
msgstr "The console holds the full error. Where decimation coarsened an always-on mesh, a hole may show through it; a looser budget or tolerance makes one less likely."

msgid "MeshOptimizer:diag:budget-not-met"
msgstr "Mesh Optimizer did not reach the triangle count"

msgid "MeshOptimizer:diag:budget-not-met:description"
msgstr "The avatar has {0} triangles against a target of {1}; {2} of them are hidden triangles written back because the cut took their cover."

msgid "MeshOptimizer:diag:budget-not-met:hint"
msgstr "Renderers excluded from decimation or left as they were count in full, the face keeps half its triangles, vertices on fingers or on bones an animation grows from zero scale are never removed, and no layer of clothing is cut closer to the layer beside it than its share of the gap between them. Raise the target, or allow more renderers to be decimated."

msgid "MeshOptimizer:diag:budget-ceiling-held"
msgstr "Mesh Optimizer stopped at its error ceiling before the triangle count"

msgid "MeshOptimizer:diag:budget-ceiling-held:description"
msgstr "The avatar has {0} triangles against a target of {1}: reaching it would move the surface further than the {2} mm the error ceiling allows."

msgid "MeshOptimizer:diag:budget-ceiling-held:hint"
msgstr "The meshes are cut no further than the ceiling allows, rather than distorted to meet the count. Raise the target to an amount the avatar reaches within the ceiling."

msgid "MeshOptimizer:diag:always-on-is-off"
msgstr "An always-on renderer is off"

msgid "MeshOptimizer:diag:always-on-is-off:description"
msgstr "{0} is listed as always on, but it is disabled or inactive when the avatar loads, so it hides nothing."

msgid "MeshOptimizer:diag:always-on-is-off:hint"
msgstr "Remove it from the always-on list, or make it active in the scene."

msgid "MeshOptimizer:diag:multiple-components"
msgstr "More than one Mesh Optimizer on the avatar"

msgid "MeshOptimizer:diag:multiple-components:description"
msgstr "Found {0}; only the settings on {1} were used."

msgid "MeshOptimizer:diag:multiple-components:hint"
msgstr "Keep one Mesh Optimizer per avatar."

msgid "MeshOptimizer:diag:pass-failed"
msgstr "Mesh Optimizer failed"

msgid "MeshOptimizer:diag:pass-failed:description"
msgstr "The avatar was left as it was: {0}"

msgid "MeshOptimizer:diag:pass-failed:hint"
msgstr "The console holds the full error."

msgid "MeshOptimizer:diag:never-occludes-unmatched"
msgstr "A never-occludes material matched nothing"

msgid "MeshOptimizer:diag:never-occludes-unmatched:description"
msgstr "{0} is set to never occlude, but no renderer on the avatar uses it or a clone of it by the same name, so the setting does nothing: the material that replaced it may still hide triangles behind it."

msgid "MeshOptimizer:diag:never-occludes-unmatched:hint"
msgstr "Set the override on the material the renderer uses at build, or remove the override if the material is gone."

msgid "MeshOptimizer:diag:non-finite-vertex"
msgstr "Mesh Optimizer skipped a mesh with a vertex that is not a number"

msgid "MeshOptimizer:diag:non-finite-vertex:description"
msgstr "{0} was left as it was: its vertex {1} has a position or texture coordinate that is not a finite number, which every error the optimizer measures would read as no error at all."

msgid "MeshOptimizer:diag:non-finite-vertex:hint"
msgstr "Re-export the mesh from its source; a broken export or bone weight usually leaves such a vertex."

msgid "MeshOptimizer:diag:non-finite-shape-key"
msgstr "Mesh Optimizer skipped a mesh with a shape key that is not a number"

msgid "MeshOptimizer:diag:non-finite-shape-key:description"
msgstr "{0} was left as it was: its shape key {1} moves vertex {2} by a distance that is not a finite number, which every error the optimizer measures would read as no error at all."

msgid "MeshOptimizer:diag:non-finite-shape-key:hint"
msgstr "Fix or remove the shape key in the mesh's source and re-export it."

msgid "MeshOptimizer:diag:duplicate-shape-key"
msgstr "Mesh Optimizer skipped a mesh with two shape keys of one name"

msgid "MeshOptimizer:diag:duplicate-shape-key:description"
msgstr "{0} was left as it was: more than one of its shape keys is named {1}, and Unity finds a shape key by its name, so a new mesh could not keep both."

msgid "MeshOptimizer:diag:duplicate-shape-key:hint"
msgstr "Rename the shape keys in the mesh's source so that each name is used once, and re-export it."

msgid "MeshOptimizer:diag:gate-failed"
msgstr "Mesh Optimizer could not measure the gate"

msgid "MeshOptimizer:diag:gate-failed:description"
msgstr "The gate measurement this build was switched on for failed, so the report holds no gate figures. The avatar is optimized as it would be without it: {0}"

msgid "MeshOptimizer:diag:gate-failed:hint"
msgstr "The console holds the full error. The gate is a measurement that runs only when switched on, so nothing on the avatar needs fixing."
