msgid ""
msgstr ""
"Language: en-us\n"

msgid "MeshOptimizer"
msgstr "Mesh Optimizer"

msgid "MeshOptimizer:decimate"
msgstr "Decimate"

msgid "MeshOptimizer:decimate:tooltip"
msgstr "Collapse edges to lower the triangle count while keeping the shape wherever the avatar bends or animates."

msgid "MeshOptimizer:removeHiddenTriangles"
msgstr "Remove hidden triangles"

msgid "MeshOptimizer:removeHiddenTriangles:tooltip"
msgstr "Delete triangles that an always-on renderer on the same bones covers from every direction."

msgid "MeshOptimizer:target"
msgstr "Target"

msgid "MeshOptimizer:target:tooltip"
msgstr "Reduce the whole avatar to a triangle count, or as far as a tolerance allows."

msgid "TargetKind:TriangleBudget"
msgstr "Triangle count"

msgid "TargetKind:Tolerance"
msgstr "Tolerance"

msgid "MeshOptimizer:triangleBudget"
msgstr "Triangle count"

msgid "MeshOptimizer:triangleBudget:tooltip"
msgstr "Triangles for the whole avatar after optimization."

msgid "MeshOptimizer:maxError"
msgstr "Max error (mm)"

msgid "MeshOptimizer:maxError:tooltip"
msgstr "How far, in millimetres, the surface may move to reach the triangle count. If the count needs more than this, it is left unmet. Set 0 for no limit."

msgid "MeshOptimizer:tolerance"
msgstr "Tolerance (mm)"

msgid "MeshOptimizer:tolerance:tooltip"
msgstr "How far, in millimetres, the optimized surface may move from the original."

msgid "MeshOptimizer:alwaysOn"
msgstr "Always-on renderers"

msgid "MeshOptimizer:alwaysOn:tooltip"
msgstr "Renderers that are never hidden. Only these can hide triangles on other meshes, so leave out anything a toggle can turn off."

msgid "MeshOptimizer:alwaysOn:help"
msgstr "Triangles covered by a renderer on this list are removed. Only list renderers that are never toggled off, because if one is hidden in game, whatever it covered shows as a hole."

msgid "MeshOptimizer:outlinesShowInside"
msgstr "Outlines show the inside"

msgid "MeshOptimizer:outlinesShowInside:tooltip"
msgstr "Keep covered triangles whose material's outline draws their back side. Turn this on for a garment whose inside you can see through its outline. Leaving it off removes more, mostly skin under clothing."

msgid "MeshOptimizer:materials"
msgstr "Material overrides"

msgid "MeshOptimizer:materials:tooltip"
msgstr "Automatic gets most materials right. Set See-through on a material with gaps that Automatic reads as solid, such as lace, mesh or cut-outs drawn with an opaque shader. Set Opaque on a solid material that Automatic reads as see-through, usually because the vendor put it on a transparent render queue or its texture's alpha is not fully solid. Analyze renderer materials shows what Automatic decides for each one."

msgid "MeshOptimizer:materials:help"
msgstr "Automatic decides whether each material on an always-on renderer hides what is behind it, so leave this list empty unless it gets one wrong. Opaque always hides what is behind it, and See-through never does."

msgid "MaterialOcclusion:material"
msgstr "Material"

msgid "MaterialOcclusion:mode"
msgstr "Treat as"

msgid "OcclusionMode:Automatic"
msgstr "Automatic"

msgid "OcclusionMode:Automatic:tooltip"
msgstr "Opaque if its render queue and render type say so. Otherwise its texture's alpha decides."

msgid "OcclusionMode:ForceOpaque"
msgstr "Opaque"

msgid "OcclusionMode:ForceOpaque:tooltip"
msgstr "Always hides what is behind it, whatever its alpha says."

msgid "OcclusionMode:NeverOccludes"
msgstr "See-through"

msgid "OcclusionMode:NeverOccludes:tooltip"
msgstr "Never hides anything behind it."

msgid "MeshOptimizer:check"
msgstr "Analyze renderer materials"

msgid "MeshOptimizer:check:tooltip"
msgstr "Show what Automatic decides for each material on the always-on renderers. Nothing is added to the overrides. Reading textures can take a moment."

msgid "MeshOptimizer:override"
msgstr "Set {0}"

msgid "MeshOptimizer:override:tooltip"
msgstr "Add this material to the overrides with the opposite setting. Only do this if Automatic got it wrong."

msgid "MeshOptimizer:verdict"
msgstr "Automatic decides"

msgid "MeshOptimizer:verdict:tooltip"
msgstr "What Automatic decides for this material, worked out the same way the build does it. If another tool swaps the material during the build, the result can differ."

msgid "MeshOptimizer:verdict:opaque"
msgstr "Opaque"

msgid "MeshOptimizer:verdict:opaque:tooltip"
msgstr "Its render queue and render type say opaque, so it hides what is behind it. If the surface has gaps the mesh does not, such as lace or mesh, set See-through."

msgid "MeshOptimizer:verdict:by-alpha"
msgstr "{0}% solid"

msgid "MeshOptimizer:verdict:by-alpha:tooltip"
msgstr "Solid on this share of its texture and see-through on the rest, judged texel by texel from the texture's alpha. If the surface is solid all over, set Opaque."

msgid "MeshOptimizer:verdict:see-through"
msgstr "See-through"

msgid "MeshOptimizer:verdict:see-through:tooltip"
msgstr "It may be transparent and its alpha cannot be read from its textures, so it hides nothing. If the surface is solid, set Opaque."

msgid "MeshOptimizer:verdict:unchecked"
msgstr "Not analyzed"

msgid "MeshOptimizer:verdict:unchecked:tooltip"
msgstr "Changed since the last analysis. Press Analyze renderer materials again."

msgid "MeshOptimizer:renderers"
msgstr "Renderer settings"

msgid "RendererSettings:renderer"
msgstr "Renderer"

msgid "RendererSettings:excludeFromDecimation"
msgstr "Exclude from decimation"

msgid "RendererSettings:excludeFromDecimation:tooltip"
msgstr "Never decimate this renderer. Its hidden triangles are still removed."

msgid "MeshOptimizer:column:exclude"
msgstr "Exclude"

msgid "MeshOptimizer:column:exclude:tooltip"
msgstr "Never decimate this renderer. Its hidden triangles are still removed."

msgid "RendererSettings:protection"
msgstr "Protection"

msgid "RendererSettings:protection:tooltip"
msgstr "How much detail this renderer keeps. Its error counts this many times over against the target, so 1 is neutral and higher keeps more."

msgid "MeshOptimizer:faceFloor"
msgstr "Face keeps at least"

msgid "MeshOptimizer:faceFloor:tooltip"
msgstr "The smallest share of its triangles the lip-sync face mesh keeps, whatever the target. The face deforms the most and other players are looking at it, so the reduction happens elsewhere first."

msgid "MeshOptimizer:lockFingers"
msgstr "Lock fingers"

msgid "MeshOptimizer:lockFingers:tooltip"
msgstr "Never remove vertices on the fingers, found through the humanoid rig. Fingers bend at every joint and fall apart quickly when decimated."

msgid "MeshOptimizer:fingerWeight"
msgstr "Finger weight"

msgid "MeshOptimizer:fingerWeight:tooltip"
msgstr "A vertex with at least this much skin weight on a finger bone counts as part of the finger. Lower values lock more of the hand."

msgid "MeshOptimizer:advanced"
msgstr "Advanced"

msgid "MeshOptimizer:preset"
msgstr "Preset"

msgid "MeshOptimizer:preset:tooltip"
msgstr "A starting tolerance. Fine keeps the most detail and Coarse removes the most. Typing your own tolerance switches this to Custom."

msgid "TolerancePreset:Fine"
msgstr "Fine (0.5 mm)"

msgid "TolerancePreset:Standard"
msgstr "Standard (1 mm)"

msgid "TolerancePreset:Medium"
msgstr "Medium (2 mm)"

msgid "TolerancePreset:Coarse"
msgstr "Coarse (3 mm)"

msgid "TolerancePreset:Custom"
msgstr "Custom"

msgid "MeshOptimizer:preview"
msgstr "Preview decimation"

msgid "MeshOptimizer:preview:tooltip"
msgstr "Show the decimated meshes in the Scene view. The first time it processes every mesh, which can take a few seconds. After that, changing the target updates it almost at once. It turns off whenever a scene opens."

msgid "MeshOptimizer:preview:off"
msgstr "The preview is off."

msgid "MeshOptimizer:list:empty"
msgstr "Empty. Drag objects here, several at once if you like."

msgid "MeshOptimizer:preview:pending"
msgstr "Computing the preview."

msgid "MeshOptimizer:preview:result"
msgstr "Triangles {0} → {1}, error level {2} mm"

msgid "MeshOptimizer:preview:failed"
msgstr "The preview failed. {0}"

msgid "MeshOptimizer:preview:note:descriptor"
msgstr "These counts are estimated from the avatar descriptor, and the build's report has the exact numbers. The preview shows decimation only. Hidden triangles are removed when you build."

msgid "MeshOptimizer:preview:note:every-key-live"
msgstr "The avatar root has no avatar descriptor, so these counts treat every shape key as animated. The build's report has the exact numbers. The preview shows decimation only. Hidden triangles are removed when you build."

msgid "MeshOptimizer:preview:progress"
msgstr "Mesh Optimizer preview"

msgid "MeshOptimizer:preview:progress:info"
msgstr "Recording the decimation of {0}"

msgid "MeshOptimizer:diag:not-readable"
msgstr "Mesh Optimizer cannot read {1}"

msgid "MeshOptimizer:diag:not-readable:description"
msgstr "{0} was left unchanged because its mesh {1} cannot be read in play mode."

msgid "MeshOptimizer:diag:not-readable:hint"
msgstr "Turn on Read/Write in the model's import settings, or build for upload, where the mesh can be read."

msgid "MeshOptimizer:diag:cloth"
msgstr "Mesh Optimizer skipped a renderer with Cloth"

msgid "MeshOptimizer:diag:cloth:description"
msgstr "{0} was left unchanged. Its Cloth component refers to the mesh's vertices by index, so none of them can be removed."

msgid "MeshOptimizer:diag:cloth:hint"
msgstr "If this renderer's triangle count matters, reduce its mesh before adding Cloth. Otherwise there is nothing to do."

msgid "MeshOptimizer:diag:renderer-failed"
msgstr "Mesh Optimizer failed on a renderer"

msgid "MeshOptimizer:diag:renderer-failed:description"
msgstr "{0} failed during {1}. Every other renderer was still optimized. {2}"

msgid "MeshOptimizer:diag:renderer-failed:hint"
msgstr "The full error is in the console. A renderer that failed during Extraction or Writing was left unchanged, and one that failed during Decimation still had its hidden triangles removed."

msgid "MeshOptimizer:diag:occlusion-failed"
msgstr "Mesh Optimizer could not find hidden triangles"

msgid "MeshOptimizer:diag:occlusion-failed:description"
msgstr "Finding hidden triangles failed, so none were removed. {0}"

msgid "MeshOptimizer:diag:occlusion-failed:hint"
msgstr "The full error is in the console. Decimation still ran."

msgid "MeshOptimizer:diag:rejudge-failed"
msgstr "Mesh Optimizer could not check hidden triangles against the decimated meshes"

msgid "MeshOptimizer:diag:rejudge-failed:description"
msgstr "Checking whether decimation exposed any removed triangles failed, so they all stay removed. {0}"

msgid "MeshOptimizer:diag:rejudge-failed:hint"
msgstr "The full error is in the console. Where an always-on mesh was decimated, a hole may show through it. A looser budget or tolerance makes that less likely."

msgid "MeshOptimizer:diag:budget-not-met"
msgstr "Mesh Optimizer did not reach the triangle count"

msgid "MeshOptimizer:diag:budget-not-met:description"
msgstr "The avatar has {0} triangles against a target of {1}. {2} of them are hidden triangles that were put back because decimation removed what covered them."

msgid "MeshOptimizer:diag:budget-not-met:hint"
msgstr "Some triangles are never cut. Renderers excluded from decimation or left unchanged count in full, the face keeps the share set under Advanced, vertices on fingers or on bones an animation grows from zero scale are kept, and no clothing layer is cut closer to the next than its share of the gap between them. Raise the target, or let more renderers be decimated."

msgid "MeshOptimizer:diag:budget-ceiling-held"
msgstr "Mesh Optimizer stopped at its error ceiling before the triangle count"

msgid "MeshOptimizer:diag:budget-ceiling-held:description"
msgstr "The avatar has {0} triangles against a target of {1}. Reaching the target would move the surface more than the {2} mm the error ceiling allows."

msgid "MeshOptimizer:diag:budget-ceiling-held:hint"
msgstr "The meshes were cut only as far as the ceiling allows instead of being distorted to hit the count. Raise the triangle count to one the avatar can reach, or raise Max error."

msgid "MeshOptimizer:diag:always-on-is-off"
msgstr "An always-on renderer is off"

msgid "MeshOptimizer:diag:always-on-is-off:description"
msgstr "{0} is listed as always on, but it is disabled or inactive when the avatar loads, so it hides nothing."

msgid "MeshOptimizer:diag:always-on-is-off:hint"
msgstr "Remove it from the always-on list, or make it active in the scene."

msgid "MeshOptimizer:diag:multiple-components"
msgstr "More than one Mesh Optimizer on the avatar"

msgid "MeshOptimizer:diag:multiple-components:description"
msgstr "Found {0}. Only the settings on {1} were used."

msgid "MeshOptimizer:diag:multiple-components:hint"
msgstr "Keep one Mesh Optimizer per avatar."

msgid "MeshOptimizer:diag:pass-failed"
msgstr "Mesh Optimizer failed"

msgid "MeshOptimizer:diag:pass-failed:description"
msgstr "The avatar was left unchanged. {0}"

msgid "MeshOptimizer:diag:pass-failed:hint"
msgstr "The full error is in the console."

msgid "MeshOptimizer:diag:never-occludes-unmatched"
msgstr "A see-through override matched nothing"

msgid "MeshOptimizer:diag:never-occludes-unmatched:description"
msgstr "{0} is set to See-through, but no renderer on the avatar uses it or a clone of it with the same name, so the setting does nothing. Whatever material replaced it may still hide triangles."

msgid "MeshOptimizer:diag:never-occludes-unmatched:hint"
msgstr "Set the override on the material the renderer uses at build, or remove the override if the material is gone."

msgid "MeshOptimizer:diag:non-finite-vertex"
msgstr "Mesh Optimizer skipped a mesh with a vertex that is not a number"

msgid "MeshOptimizer:diag:non-finite-vertex:description"
msgstr "{0} was left unchanged. Its vertex {1} has a position or texture coordinate that is not a finite number, which would make every error the optimizer measures read as zero."

msgid "MeshOptimizer:diag:non-finite-vertex:hint"
msgstr "Re-export the mesh from its source. A broken export or bone weight usually causes this."

msgid "MeshOptimizer:diag:non-finite-shape-key"
msgstr "Mesh Optimizer skipped a mesh with a shape key that is not a number"

msgid "MeshOptimizer:diag:non-finite-shape-key:description"
msgstr "{0} was left unchanged. Its shape key {1} moves vertex {2} by a distance that is not a finite number, which would make every error the optimizer measures read as zero."

msgid "MeshOptimizer:diag:non-finite-shape-key:hint"
msgstr "Fix or remove the shape key in the mesh's source and re-export it."

msgid "MeshOptimizer:diag:duplicate-shape-key"
msgstr "Mesh Optimizer skipped a mesh with two shape keys of one name"

msgid "MeshOptimizer:diag:duplicate-shape-key:description"
msgstr "{0} was left unchanged. More than one of its shape keys is named {1}, and because Unity finds shape keys by name, a new mesh could not keep both."

msgid "MeshOptimizer:diag:duplicate-shape-key:hint"
msgstr "Rename the shape keys in the mesh's source so each name is used once, then re-export it."

msgid "MeshOptimizer:diag:gate-failed"
msgstr "Mesh Optimizer could not measure the gate"

msgid "MeshOptimizer:diag:gate-failed:description"
msgstr "The gate measurement switched on for this build failed, so the report has no gate figures. The avatar is optimized exactly as it would be without it. {0}"

msgid "MeshOptimizer:diag:gate-failed:hint"
msgstr "The full error is in the console. The gate only runs when it is switched on, so nothing on the avatar needs fixing."

msgid "PipelineStage:Extraction"
msgstr "Extraction"

msgid "PipelineStage:Decimation"
msgstr "Decimation"

msgid "PipelineStage:Writing"
msgstr "Writing"

msgid "MeshOptimizer:summary:budget-met"
msgstr "[Mesh Optimizer] {0}: {1} -> {2} triangles ({3} hidden removed, {4} decimated). Budget {5} met, error level {6} mm, {7} ms."

msgid "MeshOptimizer:summary:budget-not-met"
msgstr "[Mesh Optimizer] {0}: {1} -> {2} triangles ({3} hidden removed, {4} decimated). Budget {5} NOT met, error level {6} mm, {7} ms."

msgid "MeshOptimizer:summary:tolerance"
msgstr "[Mesh Optimizer] {0}: {1} -> {2} triangles ({3} hidden removed, {4} decimated). Tolerance {5} mm, error level {6} mm, {7} ms."
